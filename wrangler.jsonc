//
// Cloudflare Workers & Pages builds previews of the game from this repository (the Worker is called
// last-combustion). The game is a static site, so the Worker only serves the built files in `dist`.
// The release site on GitHub Pages is built by .github/workflows/pages.yml and does not use this file.
//
// In the Worker's build settings in the Cloudflare dashboard, set:
//   - build command:   corepack enable && pnpm install --frozen-lockfile && pnpm build
//   - deploy command:  npx wrangler deploy
//   - non-production branch deploy command: npx wrangler versions upload
// and the environment variables NODE_VERSION=22 and BASE_URL=/ . Do not set any telemetry keys
// (VITE_GTAG_ID, VITE_GA_GAME_KEY, VITE_GA_SECRET_KEY): a preview should collect nothing.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "last-combustion",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
